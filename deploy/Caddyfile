(mrobot_static) {
	root * /srv/mrobot

	respond /healthz "ok" 200

	@manifest path /stable/update.json
	header @manifest Cache-Control "no-cache, no-store, must-revalidate"

	@release path /releases/*
	header @release Cache-Control "public, max-age=31536000, immutable"

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}

	file_server
}

updates.qutmrobot.cn {
	import mrobot_static
}

download.qutmrobot.cn {
	import mrobot_static
}

# Keep an HTTP-only endpoint for health checks before DNS is configured.
http://43.161.216.136 {
	import mrobot_static
}
