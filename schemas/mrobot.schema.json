{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mrobot.dev/schemas/mrobot.schema.json",
  "title": "MRobot project configuration",
  "type": "object",
  "required": ["schema_version", "project"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "project": {
      "type": "object",
      "required": ["ioc", "platform"],
      "properties": {
        "ioc": { "type": "string", "pattern": "\\.ioc$" },
        "platform": { "const": "stm32cubemx" }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": { "generated_root": { "type": "string" } },
      "additionalProperties": false
    },
    "package_roots": { "type": "array", "items": { "type": "string" } },
    "packages": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": { "type": "string" },
              "enabled": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
