{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mrobot.dev/schemas/package.schema.json",
  "title": "MRobot package manifest",
  "type": "object",
  "required": ["schema_version", "package"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "package": {
      "type": "object",
      "required": ["id", "type", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "name": { "type": "string" },
        "type": { "enum": ["platform", "board", "bsp", "device", "component", "algorithm", "module", "task"] },
        "version": { "type": "string" },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "dependencies": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "type": "string" },
              "version": { "type": "string" },
              "optional": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "requires": { "type": "array", "items": { "type": "string" } },
    "provides": { "type": "array", "items": { "type": "string" } },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "destination"],
        "properties": {
          "source": { "type": "string" },
          "destination": { "type": "string" },
          "policy": { "enum": ["generated", "scaffold"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
